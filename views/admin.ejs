<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Page</title>
    <link rel="stylesheet" href="styles/styles.css">
    <link rel="icon" href="images/favicon.png">
</head>
<body>
    <form id="guest-form" action="submit-form" method="POST">
    <legend><h1>Admin</h1></legend>
    <div class="container">
    <% if(submissions.length === 0) { %>
        <h1><b>is empty</b></h1>
    <% } else { %>
        <% submissions.forEach(submission => { %>
            <div class="grid-container">
                <div class="submission-field">
                    <h3>First Name</h3>
                    <h4><%= submission.fname %></h4>
                </div>
                <div class="submission-field">
                    <h3>Last Name:</h3>
                    <h4><%= submission.lname %> </h4>
                </div>

                <div class="submission-field">
                    <h3>Job Title:</h3>
                    <h4><%= submission.jobT %></h4>
                </div>

                <div class="submission-field">
                    <h3>Company:</h3>
                    <h4><%= submission.company %></h4>
                </div>

                <div class="submission-field">
                    <h3>Linkedin URL:</h3>
                    <h4><%= submission.linkedin %></h4>
                </div>

                <div class="submission-field">
                    <h3>Email Address:</h3>
                    <h4><%= submission.email %></h4>
                </div>

                <div class="submission-field">
                    <h3>How We Met:</h3>
                    <h4><%= submission.met %></h4>
                </div>

                <div class="submission-field">
                    <h3>Message:</h3>
                    <h4><%= submission.message %></h4>
                </div>

                <div class="submission-field">
                    <h3>Added to Mailing List?:</h3>
                    <h4><%= submission.added || 'No' %></h4>
                </div>

                <div class="submission-field">
                    <h3>Email Format Choice:</h3>
                    <h4><%= submission.choiceFormat %></h4>
                </div>

                <div class="submission-field">
                    <h3>Submission Time:</h3>
                    <h4><%= submission.submissionTime %></h4>
                </div>
            </div>
            <br>
            <hr>
        <% }); %>
    <% } %>
    </div>
    </form>
  
</body>
</html>